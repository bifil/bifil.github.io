---
import SiteLayout from '../../layouts/SiteLayout.astro';

const researchTraining = [
	{
		number: '01',
		title: 'Independent research agenda',
		description:
			'Own a first-author research thread within the lab’s directions—inverse problems, biomedical imaging AI, or embodied perception—from problem formulation to publication.',
	},
	{
		number: '02',
		title: 'Clinical & industrial collaboration',
		description:
			'Work with real clinical partners (e.g., Seoul National University Hospital) and industry collaborators on funded national projects.',
	},
	{
		number: '03',
		title: 'Full research lifecycle',
		description:
			'From mathematical theory and algorithm design to reproducible code, large-scale experiments, and manuscript writing for top-tier venues.',
	},
];
---

<SiteLayout
	title="Ph.D. Program · BIFIL @ DGIST"
	description="Tentative information for prospective Ph.D. students at BIFIL, DGIST — research training, funding, and how to apply."
>
	<section class="subpage-hero">
		<div class="shell">
			<p class="section-label">Students / Doctoral</p>
			<span class="tentative-badge">Tentative · Subject to official DGIST admission guidelines</span>
			<h1>Ph.D.<br /><em>Program.</em></h1>
			<p class="subpage-lede">
				A full-time doctoral track for students who want to build mathematically grounded AI for biomedical
				imaging, inverse problems, and embodied perception—and publish first-author work at top-tier venues.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-intro">
				<p class="section-label">01 / Training</p>
				<h2>What you will do.</h2>
				<p>All details on this page are provisional and will be finalized with the official admission cycle.</p>
			</div>

			<div class="research-list">
				{researchTraining.map((item) => (
					<article class="research-row">
						<span class="row-number">{item.number}</span>
						<div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-intro">
				<p class="section-label">02 / Support</p>
				<h2>Funding &<br />environment.</h2>
				<p>Planned support for doctoral students (tentative).</p>
			</div>

			<div class="info-grid">
				<article class="info-card">
					<h3>Financial support</h3>
					<ul>
						<li>Full tuition coverage (tentative)</li>
						<li>Monthly research stipend from funded projects</li>
						<li>Domestic & international conference travel support</li>
					</ul>
				</article>
				<article class="info-card">
					<h3>Research environment</h3>
					<ul>
						<li>GPU computing resources for large-scale experiments</li>
						<li>Access to clinical imaging datasets through active collaborations</li>
						<li>Weekly 1:1 meetings and group seminars</li>
					</ul>
				</article>
				<article class="info-card">
					<h3>Career development</h3>
					<ul>
						<li>Mentorship toward academia or industry research careers</li>
						<li>Internship and collaboration opportunities with partner institutions</li>
						<li>Support for fellowships and awards</li>
					</ul>
				</article>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-intro">
				<p class="section-label">03 / Apply</p>
				<h2>How to apply.</h2>
				<p>We welcome applicants from EE, CS, BME, physics, mathematics, and related fields.</p>
			</div>

			<ol class="apply-steps">
				<li>
					<div>
						<h3>Get in touch</h3>
						<p>
							Email the PI with your CV, unofficial transcript, and a brief statement (≤ 1 page) on your
							research interests and why BIFIL is a good fit.
						</p>
					</div>
				</li>
				<li>
					<div>
						<h3>Discussion & interview</h3>
						<p>
							If there is a potential match, we will arrange a meeting to discuss research directions,
							expectations, and funding.
						</p>
					</div>
				</li>
				<li>
					<div>
						<h3>Official admission</h3>
						<p>
							Submit the official application through the DGIST admission process (Robotics & Mechatronics
							Engineering). Deadlines follow the university’s admission calendar.
						</p>
					</div>
				</li>
			</ol>

			<div class="subpage-actions">
				<a
					class="button button-primary"
					href="mailto:skang@dgist.ac.kr?subject=Ph.D.%20Inquiry%20to%20BIFIL%20(DGIST)"
				>
					Contact the PI <span>↗</span>
				</a>
				<a class="text-link" href="/students/ms">M.S. Program <span>↗</span></a>
			</div>
		</div>
	</section>
</SiteLayout>
