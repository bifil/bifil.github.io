---
import '../styles/global.css';
import { journalPublications, preparingPapers } from '../data/publications';

const publicationsByYear = [...new Set(journalPublications.map((p) => p.year))].map((year) => ({
	year,
	items: journalPublications.filter((p) => p.year === year),
}));

const researchAreas = [
	{
		number: '01',
		title: 'Inverse problems & generative learning',
		description:
			'We design principled algorithms that recover structure—and uncertainty—from incomplete measurements.',
		tags: ['Inverse problems', 'Diffusion & flow', 'Posterior sampling'],
		related: 'Anatomy-guided PET reconstruction using the ℓ1-Bowsher prior (PMB 2021)',
	},
	{
		number: '02',
		title: 'Biomedical imaging & quantification',
		description:
			'We turn PET, SPECT, CT, and MRI into reliable quantitative evidence for research and clinical decisions.',
		tags: ['PET / SPECT', 'Quantitative AI', 'Clinical translation'],
		related: 'Fast and accurate amyloid brain PET quantification without MRI (JNM 2023)',
	},
	{
		number: '03',
		title: 'Embodied perception & robotics',
		description:
			'We extend measurement-aware intelligence to systems that must perceive, reason, and act in the physical world.',
		tags: ['Robot learning', 'VLA', 'Perception–action'],
		related: 'Vision–language–action models under partial, noisy observation',
	},
];

const selectedWork = [
	{
		year: '2025',
		venue: 'Journal of Nuclear Medicine',
		title: 'AI-powered quantification of flortaucipir PET for detecting tau pathology',
		note: 'Co-first author',
	},
	{
		year: '2024',
		venue: 'British Journal of Radiology',
		title: 'Sixty-four-fold data reduction of chest radiographs using super-resolution',
		note: 'Co-first author',
	},
	{
		year: '2023',
		venue: 'Journal of Nuclear Medicine',
		title: 'Fast and accurate amyloid brain PET quantification without MRI',
		note: 'First author',
	},
	{
		year: '2021',
		venue: 'NeuroImage',
		title: 'Translating amyloid PET of different radiotracers with a deep generative model',
		note: 'First author',
	},
];

const featuredProjects = [
	{
		number: 'P1',
		title: 'Brain Aid on Your Smartphone (BAYS)',
		funder: 'Korea Health Industry Development Institute (KHIDI)',
		grant: 'RS-2025-25455095',
		role: 'Principal Investigator',
		description:
			'Development of a healthy aging service using a brain age and cognitive reserve-based foundation model and a digital therapeutics platform.',
		tags: ['Brain Age', 'Cognitive Reserve', 'Digital Therapeutics'],
	},
	{
		number: 'P2',
		title: 'AI Solution for Radioisotope Therapy Dosimetry',
		funder: 'Korea Technology and Information Promotion Agency for SMEs (TIPA)',
		grant: 'RS-2025-02222237',
		role: 'Principal Investigator',
		description:
			'Development of an AI solution and platform for internal radioisotope therapy dosimetry and treatment planning.',
		tags: ['Dosimetry', 'Treatment Planning', 'Nuclear Medicine'],
	},
	{
		number: 'P3',
		title: 'Longitudinal Neuroimaging Analysis for Dementia',
		funder: 'Korea Dementia Research Center',
		grant: 'RS-2023-KH136195',
		role: 'Principal Investigator',
		collab: 'Seoul National University Hospital',
		description:
			'Development of an AI-based longitudinal neuroimaging analysis platform for monitoring dementia progression and treatment response.',
		tags: ['Longitudinal Analysis', 'Neuroimaging', 'Dementia'],
	},
];

