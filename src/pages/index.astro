---
import '../styles/global.css';

const researchAreas = [
	{
		number: '01',
		title: 'Inverse problems & generative learning',
		description:
			'We design principled algorithms that recover structure—and uncertainty—from incomplete measurements.',
		tags: ['Inverse problems', 'Diffusion & flow', 'Posterior sampling'],
	},
	{
		number: '02',
		title: 'Biomedical imaging & quantification',
		description:
			'We turn PET, SPECT, CT, and MRI into reliable quantitative evidence for research and clinical decisions.',
		tags: ['PET / SPECT', 'Quantitative AI', 'Clinical translation'],
	},
	{
		number: '03',
		title: 'Embodied perception & robotics',
		description:
			'We extend measurement-aware intelligence to systems that must perceive, reason, and act in the physical world.',
		tags: ['Robot learning', 'VLA', 'Perception–action'],
	},
];

const selectedWork = [
	{
		year: '2025',
		venue: 'Journal of Nuclear Medicine',
		title: 'AI-powered quantification of flortaucipir PET for detecting tau pathology',
		note: 'Co-first author',
	},
	{
		year: '2024',
		venue: 'British Journal of Radiology',
		title: 'Sixty-four-fold data reduction of chest radiographs using super-resolution',
		note: 'Co-first author',
	},
	{
		year: '2023',
		venue: 'Journal of Nuclear Medicine',
		title: 'Fast and accurate amyloid brain PET quantification without MRI',
		note: 'First author',
	},
	{
		year: '2021',
		venue: 'NeuroImage',
		title: 'Translating amyloid PET of different radiotracers with a deep generative model',
		note: 'First author',
	},
];

const brainWidth = 63;
const brainHeight = 31;
const palette = ['.', ':', '+', '*', '#', '%'];
const brainCharacters: Array<{ char: string; x: number; y: number; order: number }> = [];

for (let row = 0; row < brainHeight; row += 1) {
	for (let column = 0; column < brainWidth; column += 1) {
		const x = (column / (brainWidth - 1) - 0.5) * 2;
		const y = (row / (brainHeight - 1) - 0.5) * 2;
		const rounded = Math.pow(Math.abs(x / 0.98), 2.35) + Math.pow(Math.abs((y + 0.01) / 0.78), 2.35);
		const lowerTaper = y > 0.42 ? Math.abs(x) < 0.92 - (y - 0.42) * 0.34 : true;
		const topNotch = y < -0.52 && Math.abs(x) < 0.075 + (-y - 0.52) * 0.12;
		const fissure = y < 0.28 && Math.abs(x) < 0.021 + Math.max(0, -y) * 0.015;

		if (rounded > 1 || !lowerTaper || topNotch || fissure) continue;

		const edge = rounded > 0.86;
		const foldA = Math.sin(x * 13.5 + Math.sin(y * 5.8) * 2.4);
		const foldB = Math.cos(y * 14.2 - Math.sin(x * 4.6) * 2.1);
		const fold = Math.abs(foldA + foldB * 0.72);
		const groove = !edge && fold < 0.18 && Math.abs(x) > 0.08;

		if (groove && (row + column) % 3 !== 0) continue;

		const index = edge ? 5 : Math.min(palette.length - 1, Math.floor(fold * 2.25) + 1);
		brainCharacters.push({
			char: palette[index],
			x: column / (brainWidth - 1),
			y: row / (brainHeight - 1),
			order: row * brainWidth + column,
		});
	}
}

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ResearchOrganization',
	name: 'Biomedical Imaging and Frontier Intelligence Laboratory',
	alternateName: 'BIFIL',
	url: 'https://bifil.github.io',
	description:
		'Mathematically grounded AI for biomedical imaging, generative inverse problems, trustworthy quantification, and embodied perception.',
	parentOrganization: {
		'@type': 'CollegeOrUniversity',
		name: 'Daegu Gyeongbuk Institute of Science and Technology',
		alternateName: 'DGIST',
	},
	founder: {
		'@type': 'Person',
		name: 'Seung Kwan Kang',
		jobTitle: 'Assistant Professor',
		email: 'skang@dgist.ac.kr',
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="BIFIL at DGIST develops mathematically grounded AI for biomedical imaging, inverse problems, and embodied perception."
		/>
		<meta name="theme-color" content="#050505" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://bifil.github.io" />
		<meta property="og:title" content="BIFIL · Biomedical Imaging & Frontier Intelligence Lab" />
		<meta
			property="og:description"
			content="Intelligence from incomplete measurements—across biomedical imaging and embodied perception."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>BIFIL · Biomedical Imaging & Frontier Intelligence Lab</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<nav class="nav shell" aria-label="Primary navigation">
				<a class="brand" href="#top" aria-label="BIFIL home">
					<span class="brand-symbol" aria-hidden="true">B/</span>
					<span><strong>BIFIL</strong><small>DGIST</small></span>
				</a>

				<div class="nav-links">
					<a href="#research">Research</a>
					<a href="#work">Work</a>
					<a href="#people">People</a>
					<a href="#students">For students</a>
				</div>

				<a class="nav-contact" href="mailto:skang@dgist.ac.kr">Contact ↗</a>
			</nav>
		</header>

		<main id="main">
			<section class="hero" id="top">
				<div class="shell hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">BIFIL / Biomedical Imaging + Frontier Intelligence</p>
						<h1>Intelligence from<br /><em>incomplete</em><br />measurements.</h1>
						<p class="hero-lede">
							We build mathematically grounded AI that sees beyond limited data—from biomedical images to
							embodied perception.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href="#research">Explore research <span>↓</span></a>
							<a class="text-link" href="#students">Join the lab <span>↗</span></a>
						</div>
					</div>

					<div
						class="ascii-visual"
						data-brain
						role="img"
						aria-label="Interactive ASCII brain that responds to pointer movement"
						tabindex="0"
					>
						<div class="ascii-topline" aria-hidden="true">
							<span>[ latent structure ]</span>
							<span>move pointer ↘</span>
						</div>
						<div class="brain-field" aria-hidden="true">
							<div class="brain-halo"></div>
							{brainCharacters.map((item) => (
								<span
									class="brain-char"
									data-x={item.x}
									data-y={item.y}
									style={`--x:${item.x * 100}%;--y:${item.y * 100}%;--order:${item.order}`}
								>
									{item.char}
								</span>
							))}
						</div>
						<div class="ascii-footer" aria-hidden="true">
							<span>y = A(x) + ε</span>
							<span>signal → structure</span>
						</div>
					</div>
				</div>

				<div class="shell hero-foot">
					<p>Robotics & Mechatronics Engineering · DGIST</p>
					<div class="hero-stats" aria-label="Research track record">
						<span><strong>28</strong> journal articles</span>
						<span><strong>6</strong> patents</span>
						<span><strong>3</strong> PI-led programs</span>
					</div>
				</div>
			</section>

			<section class="section" id="research">
				<div class="shell">
					<div class="section-intro">
						<p class="section-label">01 / Research</p>
						<h2>One idea,<br />three directions.</h2>
						<p>Infer what matters when measurements are noisy, sparse, or incomplete.</p>
					</div>

					<div class="research-list">
						{researchAreas.map((area) => (
							<article class="research-row">
								<span class="row-number">{area.number}</span>
								<div>
									<h3>{area.title}</h3>
									<p>{area.description}</p>
									<ul aria-label={`${area.title} topics`}>
										{area.tags.map((tag) => <li>{tag}</li>)}
									</ul>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="section work-section" id="work">
				<div class="shell work-layout">
					<div class="work-heading">
						<p class="section-label">02 / Selected work</p>
						<h2>Theory that<br />travels.</h2>
						<p>From mathematical models to externally validated clinical software.</p>
					</div>

					<div class="work-list">
						{selectedWork.map((item) => (
							<article class="work-row">
								<div class="work-meta"><span>{item.year}</span><span>{item.venue}</span></div>
								<h3>{item.title}</h3>
								<p>{item.note}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="section people-section" id="people">
				<div class="shell people-layout">
					<div>
						<p class="section-label">03 / Principal investigator</p>
						<p class="pi-monogram" aria-hidden="true">SK<span>.</span></p>
					</div>
					<div class="pi-copy">
						<h2>Seung Kwan Kang, Ph.D.</h2>
						<p class="pi-role">Assistant Professor · DGIST</p>
						<p class="pi-bio">
							An electrical engineer and biomedical imaging researcher working across inverse problems, AI, and
							clinical translation. Previously AI Research Director at Brightonix Imaging and Investment Director
							at Samsung Venture Investment.
						</p>
						<a class="text-link" href="mailto:skang@dgist.ac.kr">skang@dgist.ac.kr <span>↗</span></a>
					</div>
				</div>
			</section>

			<section class="student-section" id="students">
				<div class="shell student-layout">
					<div>
						<p class="section-label">04 / For students</p>
						<h2>Curiosity<br />comes first.</h2>
					</div>
					<div class="student-copy">
						<p>
							You do not need to arrive as an expert. Bring a question you care about and a willingness to learn.
							We will connect equations, code, experiments, and real-world impact.
						</p>
						<ul>
							<li><span>Learn</span> the foundations</li>
							<li><span>Build</span> a reproducible experiment</li>
							<li><span>Grow</span> into an independent researcher</li>
						</ul>
						<a
							class="button button-dark"
							href="mailto:skang@dgist.ac.kr?subject=Undergraduate%20Research%20Inquiry%20to%20BIFIL"
						>
							Introduce yourself <span>↗</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="shell footer-layout">
				<div>
					<strong>BIFIL</strong>
					<p>Biomedical Imaging and Frontier Intelligence Laboratory</p>
				</div>
				<div>
					<p>Robotics & Mechatronics Engineering · DGIST</p>
					<p>Daegu, Republic of Korea</p>
				</div>
				<p class="copyright">© {new Date().getFullYear()} BIFIL</p>
			</div>
		</footer>

		<script>
			const brain = document.querySelector('[data-brain]');
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (brain && !prefersReducedMotion) {
				const characters = Array.from(brain.querySelectorAll('.brain-char')).map((element) => ({
					element,
					x: Number(element.getAttribute('data-x')),
					y: Number(element.getAttribute('data-y')),
					currentX: 0,
					currentY: 0,
				}));
				let pointerX = 0.5;
				let pointerY = 0.5;
				let activity = 0;
				let targetActivity = 0;
				let frame = 0;

				const requestFrame = () => {
					if (!frame) frame = window.requestAnimationFrame(animate);
				};

				const animate = () => {
					frame = 0;
					activity += (targetActivity - activity) * 0.09;
					let largestMotion = 0;

					characters.forEach((character, index) => {
						const dx = pointerX - character.x;
						const dy = pointerY - character.y;
						const distance = Math.max(0.035, Math.sqrt(dx * dx + dy * dy));
						const influence = Math.max(0, 1 - distance / 0.42) * activity;
						const wave = Math.sin(index * 0.31 + pointerX * 8 + pointerY * 6);
						const targetX = (-dx / distance) * influence * 16 + (pointerX - 0.5) * (character.x - 0.5) * 7 * activity;
						const targetY = (-dy / distance) * influence * 12 + wave * influence * 2.2;

						character.currentX += (targetX - character.currentX) * 0.13;
						character.currentY += (targetY - character.currentY) * 0.13;
						largestMotion = Math.max(largestMotion, Math.abs(character.currentX), Math.abs(character.currentY));
						character.element.style.setProperty('--tx', `${character.currentX.toFixed(2)}px`);
						character.element.style.setProperty('--ty', `${character.currentY.toFixed(2)}px`);
						character.element.style.setProperty('--energy', influence.toFixed(3));
					});

					brain.style.setProperty('--cursor-x', `${pointerX * 100}%`);
					brain.style.setProperty('--cursor-y', `${pointerY * 100}%`);

					if (Math.abs(targetActivity - activity) > 0.002 || largestMotion > 0.08) requestFrame();
				};

				const updatePointer = (event) => {
					const bounds = brain.getBoundingClientRect();
					pointerX = Math.min(1, Math.max(0, (event.clientX - bounds.left) / bounds.width));
					pointerY = Math.min(1, Math.max(0, (event.clientY - bounds.top) / bounds.height));
					targetActivity = 1;
					requestFrame();
				};

				brain.addEventListener('pointermove', updatePointer);
				brain.addEventListener('pointerleave', () => {
					targetActivity = 0;
					requestFrame();
				});
				brain.addEventListener('focus', () => {
					targetActivity = 0.55;
					requestFrame();
				});
				brain.addEventListener('blur', () => {
					targetActivity = 0;
					requestFrame();
				});
			}
		</script>
	</body>
</html>
