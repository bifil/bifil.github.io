			interface BrainMatrixNode {
				row: number;
				col: number;
				char: string;
				phase: number;
				baseX: number;
				baseY: number;
				currX: number;
				currY: number;
				targetX: number;
				targetY: number;
				vx: number;
				vy: number;
				energy: number;
			}

			interface SynapticPulse {
				x: number;
				y: number;
				time: number;
				speed: number;
				maxRadius: number;
			}

			function createMatrixBrainNodes(): BrainMatrixNode[] {
				const nodes: BrainMatrixNode[] = [];
				for (let r = 0; r < BRAIN_ASCII.length; r++) {
					const line = BRAIN_ASCII[r];
					for (let c = 0; c < line.length; c++) {
						const char = line[c];
						if (char !== ' ') {
							nodes.push({
								row: r,
								col: c,
								char,
								phase: Math.random() * Math.PI * 2,
								baseX: 0,
								baseY: 0,
								currX: 0,
								currY: 0,
								targetX: 0,
								targetY: 0,
								vx: 0,
								vy: 0,
								energy: 0,
							});
						}
					}
				}
				return nodes;
			}

			const canvas = document.getElementById('brain-canvas') as HTMLCanvasElement | null;
			const container = document.querySelector('[data-brain]') as HTMLElement | null;
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (canvas && container) {
				const ctx = canvas.getContext('2d');
				const nodes = createMatrixBrainNodes();
				const pulses: SynapticPulse[] = [];

				let width = 0;
				let height = 0;
				let dpr = 1;
				let fontSize = 12;
				let lastTime = performance.now();
				let lastPulseSpawn = 0;

				let isHovering = false;
				let pointerX = -9999;
				let pointerY = -9999;

				const resize = () => {
					const rect = container.getBoundingClientRect();
					dpr = Math.min(window.devicePixelRatio || 1, 2);
					width = rect.width;
					height = rect.height;

					canvas.width = Math.floor(width * dpr);
					canvas.height = Math.floor(height * dpr);

					if (ctx) {
						ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					}

					fontSize = width < 480 ? 9.5 : width < 768 ? 11.5 : width < 1200 ? 13 : 14.5;
					const charW = fontSize * 0.72;
					const charH = fontSize * 1.25;

					const originX = width >= 860 ? width * 0.58 : width * 0.5;
					const originY = height * 0.5;

					const centerCol = 43;
					const centerRow = 20;

					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						node.baseX = originX + (node.col - centerCol) * charW;
						node.baseY = originY + (node.row - centerRow) * charH;
						if (node.currX === 0 && node.currY === 0) {
							node.currX = node.baseX;
							node.currY = node.baseY;
							node.targetX = node.baseX;
							node.targetY = node.baseY;
						}
					}
				};

				const resizeObserver = new ResizeObserver(() => resize());
				resizeObserver.observe(container);
				resize();

				const spawnPulse = (originX: number, originY: number) => {
					pulses.push({
						x: originX,
						y: originY,
						time: performance.now(),
						speed: 280, // px per second
						maxRadius: Math.max(width, height) * 0.65,
					});
					if (pulses.length > 5) pulses.shift();
				};

				// Mouse pointer interactions: morph & transition
				const handlePointerMove = (event: PointerEvent) => {
					const rect = container.getBoundingClientRect();
					pointerX = event.clientX - rect.left;
					pointerY = event.clientY - rect.top;
					isHovering = true;

					const relX = Math.min(1, Math.max(0, pointerX / rect.width));
					const relY = Math.min(1, Math.max(0, pointerY / rect.height));
					container.style.setProperty('--cursor-x', `${relX * 100}%`);
					container.style.setProperty('--cursor-y', `${relY * 100}%`);

					// Apply fluid elastic morphing to nearby nodes
					const influenceRadius = Math.min(240, width * 0.28);
					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						const dx = pointerX - node.baseX;
						const dy = pointerY - node.baseY;
						const dist = Math.hypot(dx, dy);

						if (dist < influenceRadius) {
							const t = 1 - dist / influenceRadius;
							const force = t * t * 24;
							const swirl = Math.sin(t * Math.PI * 3.0 + node.phase) * (t * 6);
							const swirlY = Math.cos(t * Math.PI * 3.0 + node.phase) * (t * 5);

							node.targetX = node.baseX - (dx / (dist + 1)) * force + swirl;
							node.targetY = node.baseY - (dy / (dist + 1)) * force * 0.65 + swirlY;
							node.energy = Math.max(node.energy, t * 1.25);
						}
					}

					if (Math.random() < 0.05) {
						spawnPulse(pointerX, pointerY);
					}
				};

				container.addEventListener('pointermove', handlePointerMove);

				container.addEventListener('pointerdown', (event) => {
					const rect = container.getBoundingClientRect();
					const clickX = event.clientX - rect.left;
					const clickY = event.clientY - rect.top;
					spawnPulse(clickX, clickY);

					// Shockwave morph
					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						const dx = clickX - node.baseX;
						const dy = clickY - node.baseY;
						const dist = Math.hypot(dx, dy);
						if (dist < 260) {
							const t = 1 - dist / 260;
							node.targetX = node.baseX - (dx / (dist + 1)) * (t * 32);
							node.targetY = node.baseY - (dy / (dist + 1)) * (t * 22);
							node.energy = 1.0;
						}
					}
				});

				container.addEventListener('pointerleave', () => {
					isHovering = false;
					pointerX = -9999;
					pointerY = -9999;
				});

				// Main Animation Loop
				const render = (now: number) => {
					lastTime = now;

					// Spontaneous pulse
					if (now - lastPulseSpawn > 3200 && !prefersReducedMotion) {
						lastPulseSpawn = now;
						const randNode = nodes[Math.floor(Math.random() * nodes.length)];
						if (randNode) spawnPulse(randNode.baseX, randNode.baseY);
					}

					if (ctx) {
						ctx.clearRect(0, 0, width, height);
						ctx.font = `${fontSize}px 'DM Mono', Consolas, monospace`;
						ctx.textBaseline = 'middle';
						ctx.textAlign = 'center';

						// Update spring return physics & pulse excitations
						for (let i = 0; i < nodes.length; i++) {
							const node = nodes[i];

							// If not actively displaced by pointer, relax target back to base rest position
							if (!isHovering || Math.hypot(pointerX - node.baseX, pointerY - node.baseY) >= 240) {
								node.targetX += (node.baseX - node.targetX) * 0.12;
								node.targetY += (node.baseY - node.targetY) * 0.12;
							}

							// Spring physics interpolation
							node.vx = (node.vx + (node.targetX - node.currX) * 0.14) * 0.78;
							node.vy = (node.vy + (node.targetY - node.currY) * 0.14) * 0.78;
							node.currX += node.vx;
							node.currY += node.vy;

							// Pulse wave excitation
							for (let p = 0; p < pulses.length; p++) {
								const pulse = pulses[p];
								const age = (now - pulse.time) / 1000;
								const currentRadius = age * pulse.speed;
								if (currentRadius < pulse.maxRadius) {
									const dist = Math.hypot(node.baseX - pulse.x, node.baseY - pulse.y);
									const waveDist = Math.abs(dist - currentRadius);
									if (waveDist < 26) {
										const pulseStrength = (1 - waveDist / 26) * Math.max(0, 1 - currentRadius / pulse.maxRadius);
										node.energy = Math.max(node.energy, pulseStrength);
									}
								}
							}

							// Energy decay
							node.energy *= 0.94;

							// Subtle breathing wave
							const breathe = Math.sin(now * 0.0018 + node.phase) * 0.5;
							const drawY = node.currY + breathe;
							const drawX = node.currX;

							// Color & Glow rendering
							if (node.energy > 0.45) {
								ctx.fillStyle = '#ffffff';
								ctx.shadowColor = '#83f6d4';
								ctx.shadowBlur = 10;
							} else if (node.energy > 0.2) {
								ctx.fillStyle = 'rgba(202, 255, 239, 0.95)';
								ctx.shadowColor = '#83f6d4';
								ctx.shadowBlur = 5;
							} else {
								ctx.fillStyle = 'rgba(131, 246, 212, 0.72)';
								ctx.shadowBlur = 0;
							}

							ctx.fillText(node.char, drawX, drawY);
						}
					}

					window.requestAnimationFrame(render);
				};

				window.requestAnimationFrame(render);
			}
		</script>
