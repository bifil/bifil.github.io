---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="BIFIL at DGIST develops mathematically grounded AI for biomedical imaging, inverse problems, and embodied perception."
		/>
		<meta name="theme-color" content="#050505" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://bifil.github.io" />
		<meta property="og:title" content="BIFIL · Biomedical Imaging & Frontier Intelligence Lab" />
		<meta
			property="og:description"
			content="Intelligence from incomplete measurements—across biomedical imaging and embodied perception."
		/>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>BIFIL · Biomedical Imaging & Frontier Intelligence Lab</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<nav class="nav shell" aria-label="Primary navigation">
				<a class="brand" href="#home" aria-label="BIFIL home">
					<span class="brand-symbol" aria-hidden="true">BIFIL</span>
					<span><strong>Biomedical Imaging and Frontier Intelligence Laboratory</strong></span>
				</a>

				<div class="nav-links" id="nav-links" data-nav-links>
					<a href="#home">Home</a>
					<a href="#news">News</a>
					<a href="#team">Team</a>
					<a href="#research">Research</a>
					<a href="#publications">Publications</a>
					<a href="#projects">Projects</a>
				</div>

				<div class="nav-right">
					<a class="nav-contact" href="mailto:skang@dgist.ac.kr">Contact↗</a>
					<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Toggle navigation menu" data-nav-toggle>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
					</button>
				</div>
			</nav>
		</header>

		<main id="main">
			<section class="hero" id="home">
				<div
					class="hero-brain-backdrop"
					data-brain
					role="img"
					aria-label="Interactive 3D ASCII human brain background"
					tabindex="0"
				>
					<div class="brain-halo" aria-hidden="true"></div>
					<canvas id="brain-canvas" class="brain-canvas" aria-hidden="true"></canvas>
					<noscript>
						<pre class="brain-fallback" aria-hidden="true">{fallbackAscii}</pre>
					</noscript>
				</div>

				<div class="shell hero-content">
					<div class="hero-copy">
						<!-- <p class="eyebrow">BIFIL / Biomedical Imaging + Frontier Intelligence</p> -->
						<h1>Intelligence from<br /><em>incomplete</em><br />measurements.</h1>
						<p class="hero-lede">
							We build mathematically grounded AI that sees beyond limited data—from biomedical images to
							embodied perception.
						</p>
						<div class="hero-actions">
							<a class="button button-primary" href="#research">Explore research <span>↓</span></a>
							<!-- <a class="text-link" href="#projects">Join the lab <span>↗</span></a> -->
						</div>
					</div>
				</div>

				<div class="shell hero-foot">
					<p>Department of Robotics & Mechatronics Engineering | DGIST</p>
				</div>
			</section>

			<section class="section news-section" id="news">
				<div class="shell">
					<div class="section-intro">
						<p class="section-label">01 / News</p>
						<h2>Latest from<br />the lab.</h2>
					</div>

					<article class="news-feature">
						<div class="news-feature-header">
							<span class="news-badge">Recruiting</span>
							<!-- <span class="news-date">2026</span> -->
						</div>
						<h3>Now Recruiting Graduate Students & Postdocs</h3>
						<p>
							BIFIL is looking for motivated M.S. and Ph.D. students, as well as postdoctoral researchers,
							who want to work on <strong>biomedical imaging</strong> and <strong>frontier AI</strong> —
							inverse problems, generative models, and trustworthy quantification from theory to clinic.
						</p>
						<p class="news-voice">
							I am building BIFIL from the ground up — early members will help shape its research
							direction and culture, with my full attention and close mentorship from day one. If you
							are interested, please email me with your CV.
						</p>
						<div class="news-actions">
							<!-- <a class="text-link" href="/students/phd">Ph.D. Program <span>↗</span></a>
							<a class="text-link" href="/students/ms">M.S. Program <span>↗</span></a> -->
							<a class="text-link" href="mailto:skang@dgist.ac.kr?subject=Postdoc%20Inquiry%20to%20BIFIL%20(DGIST)">Position Inquiries <span>↗</span></a>
						</div>
					</article>
				</div>
			</section>

			<section class="section people-section" id="team">
				<span id="people" class="section-anchor"></span>
				<div class="shell people-layout">
					<div>
						<p class="section-label">02 / Team & Leadership</p>
						<figure class="pi-photo">
							<img
								src="/images/pi.webp"
								alt="Portrait of Seung Kwan Kang"
								width="800"
								height="1000"
								loading="lazy"
								decoding="async"
							/>
							<figcaption aria-hidden="true">SK<span>.</span></figcaption>
						</figure>
					</div>
					<div class="pi-copy">
						<h2>Seung Kwan Kang, Ph.D.</h2>
						<p class="pi-role">Assistant Professor · DGIST</p>
						<p class="pi-bio">
							A medical imaging and AI researcher working across inverse problems, AI, and
							clinical translation. Previously AI Research Director at Brightonix Imaging and Investment Director
							at Samsung Ventures.
						</p>
						<div class="team-actions">
							<a class="text-link" href="mailto:skang@dgist.ac.kr">skang@dgist.ac.kr <span>↗</span></a>
							<!-- <a class="text-link" href="#projects">Student & Postdoc Openings <span>↓</span></a> -->
						</div>
					</div>
				</div>

				<div class="shell pi-details">
					<div class="pi-detail">
						<p class="pi-detail-label">Education</p>
						<ul class="pi-timeline">
							<li>
								<span class="pi-years">2014 – 2021</span>
								<div>
									<strong>Ph.D. in Biomedical Sciences</strong>
									<span>Seoul National University College of Medicine</span>
								</div>
							</li>
							<li>
								<span class="pi-years">2010 – 2014</span>
								<div>
									<strong>B.S. in Electrical and Computer Engineering</strong>
									<span>Seoul National University</span>
								</div>
							</li>
						</ul>
					</div>

					<div class="pi-detail">
						<p class="pi-detail-label">Professional Experience</p>
						<ul class="pi-timeline">
							<li>
								<span class="pi-years">2026 – present</span>
								<div>
									<strong>Assistant Professor</strong>
									<span>DGIST · Department of Robotics & Mechatronics Engineering</span>
								</div>
							</li>
							<li>
								<span class="pi-years">2026</span>
								<div>
									<strong>Investment Director</strong>
									<span>Samsung Ventures</span>
								</div>
							</li>
							<li>
								<span class="pi-years">2021 – 2026</span>
								<div>
									<strong>Director, AI/Algorithm</strong>
									<span>Brightonix Imaging Inc.</span>
								</div>
							</li>s
						</ul>
					</div>

					<div class="pi-detail">
						<p class="pi-detail-label">Honors & Awards</p>
						<ul class="pi-timeline">
							<li>
								<span class="pi-years">2025</span>
								<div><strong>NMMI Outstanding Research Award</strong><span>Korean Society of Nuclear Medicine</span></div>
							</li>
							<li>
								<span class="pi-years">2025</span>
								<div><strong>Outstanding Paper Award in Science and Technology</strong><span>Korean Federation of Science and Technology Societies</span></div>
							</li>
							<li>
								<span class="pi-years">2021</span>
								<div><strong>Outstanding Graduate Award</strong><span>Seoul National University</span></div>
							</li>
							<li>
								<span class="pi-years">2020</span>
								<div><strong>Young Investigator Award (1st place)</strong><span>Korean Society of Nuclear Medicine</span></div>
							</li>
							<li>
								<span class="pi-years">2017 – 2020</span>
								<div><strong> Education Grants</strong><span>IEEE NSS/MIC · IEEE NPSS (×6)</span></div>
							</li>
						</ul>
					</div>
				</div>

				<div class="shell team-groups">
					<p class="team-founding">
						BIFIL is a newly founded lab — our first Ph.D., M.S., and undergraduate members will be
						announced here. Interested in joining as a founding member?
						<a class="inline-link" href="#news">See the recruiting note</a>.
					</p>
				</div>
			</section>

			<section class="section" id="research">
				<div class="shell">
					<div class="section-intro">
						<p class="section-label">03 / Research</p>
						<h2>One idea,<br />three directions.</h2>
						<p>Infer what matters when measurements are noisy, sparse, or incomplete.</p>
					</div>

					<div class="research-list">
						{researchAreas.map((area) => (
							<article class="research-row">
								<span class="row-number">{area.number}</span>
								<div>
									<h3>{area.title}</h3>
									<p>{area.description}</p>
									{area.related && <p class="research-related"><span>Related</span>{area.related}</p>}
									<ul aria-label={`${area.title} topics`}>
										{area.tags.map((tag) => <li>{tag}</li>)}
									</ul>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="section work-section" id="publications">
				<span id="work" class="section-anchor"></span>
				<div class="shell work-layout">
					<div class="work-heading">
						<p class="section-label">04 / Publications</p>
						<h2>Theory that<br />travels.</h2>
						<!-- <p>Peer-reviewed journal articles in computational imaging, nuclear medicine, and clinical AI.</p> -->
						<!-- <div class="pub-summary-stats">
							<div class="pub-stat">
								<strong>{journalPublications.length}</strong>
								<span>Journal Papers</span>
							</div>
							<div class="pub-stat">
								<strong>JNM · PMB · NeuroImage</strong>
								<span>Top Venues</span>
							</div>
						</div> -->
					</div>

					<div class="work-list">
						<div class="pub-year-group">
							<p class="pub-year-heading">In Preparation</p>
							<div class="pub-year-items">
								{preparingPapers.map((item) => (
									<article class="work-row work-row-preparing">
										<div class="work-meta">
											<div class="work-meta-left">
												<span class="pub-venue">{item.status}</span>
											</div>
											{item.badge && <span class="pub-badge">{item.badge}</span>}
										</div>
										<h3>{item.title}</h3>
										<p class="pub-authors">{item.authors}</p>
									</article>
								))}
							</div>
						</div>

						{publicationsByYear.map((group) => (
							<div class="pub-year-group">
								<p class="pub-year-heading">{group.year}</p>
								<div class="pub-year-items">
									{group.items.map((item) => (
										<article class="work-row">
											<div class="work-meta">
												<div class="work-meta-left">
													<span class="pub-venue">{item.venue}</span>
													{item.details && <span class="pub-details">· {item.details}</span>}
												</div>
												{item.badge && <span class="pub-badge">{item.badge}</span>}
											</div>
											<h3>{item.title}</h3>
											<p class="pub-authors">{item.authors}</p>
											{item.topic && <span class="pub-topic">{item.topic}</span>}
										</article>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<section class="section projects-section" id="projects">
				<span id="students" class="section-anchor"></span>
				<div class="shell">
					<div class="section-intro">
						<p class="section-label">05 / Projects</p>
						<h2>Ongoing<br />research.</h2>
						<!-- <p>
							Newly awarded grants and active research projects will be announced here as they begin.
						</p> -->
					</div>

					<div class="ongoing-placeholder">
						<span class="ongoing-badge">To be announced</span>
						<p>
							Upcoming research grants led by the lab will be listed here once they officially begin.
						</p>
					</div>

					<p class="projects-subhead">Completed Research</p>

					<div class="projects-grid">
						{featuredProjects.map((project) => (
							<article class="project-card">
								<div>
									<div class="project-meta">
										<span class="project-num">{project.number}</span>
										<span class="project-cat">{project.funder}</span>
									</div>
									<h3>{project.title}</h3>
									<p>{project.description}</p>
								</div>
								<div>
									<ul class="project-facts">
										<li><span>Role</span>{project.role}</li>
										<li><span>Grant</span>{project.grant}</li>
										{project.collab && <li><span>With</span>{project.collab}</li>}
									</ul>
									<ul class="project-tags" aria-label={`${project.title} tags`}>
										{project.tags.map((tag) => <li>{tag}</li>)}
									</ul>
								</div>
							</article>
						))}
					</div>

				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="shell footer-layout">
				<div>
					<strong>BIFIL</strong>
					<p>Biomedical Imaging and Frontier Intelligence Laboratory</p>
				</div>
				<div>
					<p>Robotics & Mechatronics Engineering · DGIST</p>
					<p>Daegu, Republic of Korea</p>
				</div>
				<p class="copyright">© {new Date().getFullYear()} BIFIL</p>
			</div>
		</footer>

		<script>
			const navToggle = document.querySelector('[data-nav-toggle]');
			const navLinks = document.querySelector('[data-nav-links]');
			if (navToggle && navLinks) {
				navToggle.addEventListener('click', () => {
					const open = navLinks.classList.toggle('nav-links-open');
					navToggle.setAttribute('aria-expanded', String(open));
				});
				navLinks.querySelectorAll('a').forEach((link) =>
					link.addEventListener('click', () => {
						navLinks.classList.remove('nav-links-open');
						navToggle.setAttribute('aria-expanded', 'false');
					}),
				);
			}
		</script>

		<script>
			const BRAIN_ASCII = [
				'                                 _tleeiln    _ienr26o',
