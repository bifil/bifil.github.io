	},
	{
		year: '2021',
		venue: 'NeuroImage',
		title: 'Translating amyloid PET of different radiotracers with a deep generative model',
		note: 'First author',
	},
];

function generateAnatomicalBrain(rotX = 0.2, rotY = 0.65, width = 78, height = 36) {
	const points: Array<{ x: number; y: number; z: number; nx: number; ny: number; nz: number; type: string }> = [];
	const hemiCount = 1400;
	for (let i = 0; i < hemiCount; i++) {
		const phi = Math.acos(1 - (2 * (i + 0.5)) / hemiCount);
		const theta = Math.PI * (1 + Math.sqrt(5)) * i;
		const sx = Math.sin(phi) * Math.cos(theta);
		const sy = Math.cos(phi);
		const sz = Math.sin(phi) * Math.sin(theta);
		const signX = sx >= 0 ? 1 : -1;
		const absSx = Math.abs(sx);
		const frontal = sz > 0 ? 1 + 0.22 * sz * (1 - sy * sy * 0.7) : 1;
		const occipital = sz < 0 ? 1 + 0.12 * sz : 1;
		const dome = sy > 0 ? 1 + 0.18 * sy * (1 - absSx * 0.4) : 1;
		const rx = 0.85 * frontal * occipital;
		const ry = 0.9 * dome;
		const rz = 1.15 * frontal * occipital;
		let temporalLobe = 0;
		if (sy < 0.0 && sy > -0.55 && sz > -0.25 && sz < 0.6) {
			temporalLobe = Math.sin(((sy + 0.55) / 0.55) * Math.PI) * Math.sin(((sz + 0.25) / 0.85) * Math.PI) * 0.32;
		}
		let sylvianFissure = 0;
		if (sy > -0.25 && sy < 0.08 && sz > -0.2 && sz < 0.5 && absSx > 0.3) {
			sylvianFissure = Math.sin(((sy + 0.25) / 0.33) * Math.PI) * 0.22;
		}
		const fissure = 0.12 * Math.exp(-Math.pow(absSx / 0.15, 2)) * (sy > -0.3 ? 1 : 0.3);
		const fold1 = Math.sin(absSx * 13 + sz * 9 + Math.sin(sy * 11) * 1.5);
		const fold2 = Math.cos(sy * 15 + Math.cos(sz * 11 + absSx * 7) * 1.4);
		const gyri = (fold1 * 0.5 + fold2 * 0.5) * 0.08;
		const px = signX * (absSx * rx + 0.16 - fissure) * (1 + temporalLobe - sylvianFissure + gyri);
		const py = (sy * ry + 0.18) * (1 + temporalLobe - sylvianFissure + gyri);
		const pz = (sz * rz + 0.08) * (1 + temporalLobe - sylvianFissure + gyri);
		if (py < -0.15 && pz < -0.32 && absSx < 0.8) continue;
		if (py < -0.38 && absSx < 0.35 && pz > -0.35 && pz < 0.2) continue;
		points.push({ x: px, y: py, z: pz, nx: sx * signX, ny: sy, nz: sz, type: 'cortex' });
	}
	const cerebCount = 500;
	for (let i = 0; i < cerebCount; i++) {
		const phi = Math.acos(1 - (2 * (i + 0.5)) / cerebCount);
		const theta = Math.PI * (1 + Math.sqrt(5)) * i;
		const sx = Math.sin(phi) * Math.cos(theta);
		const sy = Math.cos(phi);
		const sz = Math.sin(phi) * Math.sin(theta);
		const signX = sx >= 0 ? 1 : -1;
		const absSx = Math.abs(sx);
		const folia = Math.sin(sy * 36) * 0.04;
		const px = signX * (absSx * 0.65 + 0.09) * (1 + folia);
		const py = (sy * 0.44 - 0.46) * (1 + folia);
		const pz = (sz * 0.54 - 0.62) * (1 + folia);
		points.push({ x: px, y: py, z: pz, nx: sx * signX, ny: sy, nz: sz, type: 'cerebellum' });
	}
	const stemCount = 200;
	for (let i = 0; i < stemCount; i++) {
		const t = i / stemCount;
		const angle = ((i % 16) / 16) * Math.PI * 2;
		const py = -0.28 - t * 0.68;
		const ponsBulge = Math.exp(-Math.pow((py + 0.48) / 0.12, 2)) * 0.1;
		const radius = (0.17 + ponsBulge) * (1 - t * 0.28);
		const px = Math.cos(angle) * radius * 0.92;
		const pz = Math.sin(angle) * radius + ponsBulge * 0.6 - 0.14;
		points.push({ x: px, y: py, z: pz, nx: Math.cos(angle), ny: 0, nz: Math.sin(angle), type: 'brainstem' });
	}
	const grid = Array.from({ length: height }, () => Array(width).fill(' '));
	const zbuf = Array.from({ length: height }, () => Array(width).fill(-999));
	const palette = [' ', '.', ':', '-', '=', '+', '*', '#', '%', '@'];
	const cosY = Math.cos(rotY),
		sinY = Math.sin(rotY);
	const cosX = Math.cos(rotX),
		sinX = Math.sin(rotX);
	const nlx = 0.42,
		nly = 0.62,
		nlz = 0.66;
	for (const pt of points) {
		const x1 = pt.x * cosY + pt.z * sinY;
		const y1 = pt.y;
		const z1 = -pt.x * sinY + pt.z * cosY;
		const x2 = x1;
		const y2 = y1 * cosX - z1 * sinX;
		const z2 = y1 * sinX + z1 * cosX;
		const nx1 = pt.nx * cosY + pt.nz * sinY;
		const ny1 = pt.ny;
		const nz1 = -pt.nx * sinY + pt.nz * cosY;
		const nx2 = nx1;
		const ny2 = ny1 * cosX - nz1 * sinX;
		const nz2 = ny1 * sinX + nz1 * cosX;
		const factor = 46 / (3.0 + z2);
		const px = Math.floor(width / 2 + x2 * factor * 2.0);
		const py = Math.floor(height / 2 - y2 * factor);
		if (px >= 0 && px < width && py >= 0 && py < height && z2 > zbuf[py][px]) {
			zbuf[py][px] = z2;
			const dot = Math.max(0, nx2 * nlx + ny2 * nly + nz2 * nlz);
			const intensity = Math.min(1, Math.max(0, dot * 0.6 + ((z2 + 1.5) / 3.0) * 0.45));
			grid[py][px] = palette[Math.floor(intensity * (palette.length - 1))];
		}
	}
	return grid.map((r) => r.join('')).join('\n');
}

const fallbackAscii = generateAnatomicalBrain(0.2, 0.65, 78, 36);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ResearchOrganization',
	name: 'Biomedical Imaging and Frontier Intelligence Laboratory',
	alternateName: 'BIFIL',
	url: 'https://bifil.github.io',
