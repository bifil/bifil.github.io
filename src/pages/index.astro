		<script>
			interface BrainPoint {
				x: number;
				y: number;
				z: number;
				nx: number;
				ny: number;
				nz: number;
				type: 'cortex' | 'cerebellum' | 'brainstem' | 'tract';
				energy: number;
				phase: number;
			}

			interface SynapticPulse {
				x: number;
				y: number;
				z: number;
				time: number;
				speed: number;
				maxRadius: number;
			}

			function createBrainModel(): BrainPoint[] {
				const points: BrainPoint[] = [];

				// 1. CEREBRAL CORTEX (Hemispheres with lobes & sulci)
				const hemiCount = 2000;
				for (let i = 0; i < hemiCount; i++) {
					const phi = Math.acos(1 - (2 * (i + 0.5)) / hemiCount);
					const theta = Math.PI * (1 + Math.sqrt(5)) * i;

					const sx = Math.sin(phi) * Math.cos(theta);
					const sy = Math.cos(phi); // +1 superior, -1 inferior
					const sz = Math.sin(phi) * Math.sin(theta); // +1 anterior (frontal), -1 posterior (occipital)

					const signX = sx >= 0 ? 1 : -1;
					const absSx = Math.abs(sx);

					// Frontal lobe expansion (anterior: sz > 0)
					const frontal = sz > 0 ? 1 + 0.22 * sz * (1 - sy * sy * 0.7) : 1;
					// Occipital lobe taper (posterior: sz < 0)
					const occipital = sz < 0 ? 1 + 0.12 * sz : 1;
					// Sagittal superior dome (sy > 0)
					const dome = sy > 0 ? 1 + 0.18 * sy * (1 - absSx * 0.4) : 1;

					const rx = 0.85 * frontal * occipital;
					const ry = 0.9 * dome;
					const rz = 1.15 * frontal * occipital;

					// Temporal lobe hook: extends antero-inferiorly
					let temporalLobe = 0;
					if (sy < 0.0 && sy > -0.55 && sz > -0.25 && sz < 0.6) {
						temporalLobe = Math.sin(((sy + 0.55) / 0.55) * Math.PI) * Math.sin(((sz + 0.25) / 0.85) * Math.PI) * 0.32;
					}

					// Sylvian fissure (lateral sulcus indentation)
					let sylvianFissure = 0;
					if (sy > -0.25 && sy < 0.08 && sz > -0.2 && sz < 0.5 && absSx > 0.3) {
						sylvianFissure = Math.sin(((sy + 0.25) / 0.33) * Math.PI) * 0.22;
					}

					// Longitudinal fissure (groove between hemispheres at sx = 0)
					const fissure = 0.12 * Math.exp(-Math.pow(absSx / 0.15, 2)) * (sy > -0.3 ? 1 : 0.3);

					// Cortical Gyri & Sulci (multi-frequency organic convolutions)
					const fold1 = Math.sin(absSx * 13 + sz * 9 + Math.sin(sy * 11) * 1.5);
					const fold2 = Math.cos(sy * 15 + Math.cos(sz * 11 + absSx * 7) * 1.4);
					const fold3 = Math.sin(sz * 16 - sy * 9);
					const gyri = (fold1 * 0.4 + fold2 * 0.4 + fold3 * 0.2) * 0.08;

					const px = signX * (absSx * rx + 0.16 - fissure) * (1 + temporalLobe - sylvianFissure + gyri);
					const py = (sy * ry + 0.18) * (1 + temporalLobe - sylvianFissure + gyri);
					const pz = (sz * rz + 0.08) * (1 + temporalLobe - sylvianFissure + gyri);

					// Notch for cerebellum & brainstem base
					if (py < -0.15 && pz < -0.32 && absSx < 0.8) continue;
					if (py < -0.38 && absSx < 0.35 && pz > -0.35 && pz < 0.2) continue;

					points.push({
						x: px,
						y: py,
						z: pz,
						nx: sx * signX,
						ny: sy,
						nz: sz,
						type: 'cortex',
						energy: 0,
						phase: Math.random() * Math.PI * 2,
					});
				}

				// 2. CEREBELLUM (Posterior-inferior base, folia striations)
				const cerebCount = 650;
				for (let i = 0; i < cerebCount; i++) {
					const phi = Math.acos(1 - (2 * (i + 0.5)) / cerebCount);
					const theta = Math.PI * (1 + Math.sqrt(5)) * i;

					const sx = Math.sin(phi) * Math.cos(theta);
					const sy = Math.cos(phi);
					const sz = Math.sin(phi) * Math.sin(theta);

					const signX = sx >= 0 ? 1 : -1;
					const absSx = Math.abs(sx);
					const folia = Math.sin(sy * 36) * 0.04;

					const px = signX * (absSx * 0.65 + 0.09) * (1 + folia);
					const py = (sy * 0.44 - 0.46) * (1 + folia);
					const pz = (sz * 0.54 - 0.62) * (1 + folia);

					points.push({
						x: px,
						y: py,
						z: pz,
						nx: sx * signX,
						ny: sy,
						nz: sz,
						type: 'cerebellum',
						energy: 0,
						phase: Math.random() * Math.PI * 2,
					});
				}

				// 3. BRAINSTEM (Pons and Medulla)
				const stemCount = 280;
				for (let i = 0; i < stemCount; i++) {
					const t = i / stemCount;
					const angle = ((i % 16) / 16) * Math.PI * 2;
					const py = -0.28 - t * 0.68;

					const ponsBulge = Math.exp(-Math.pow((py + 0.48) / 0.12, 2)) * 0.1;
					const radius = (0.17 + ponsBulge) * (1 - t * 0.28);

					const px = Math.cos(angle) * radius * 0.92;
					const pz = Math.sin(angle) * radius + ponsBulge * 0.6 - 0.14;

					points.push({
						x: px,
						y: py,
						z: pz,
						nx: Math.cos(angle),
						ny: 0,
						nz: Math.sin(angle),
						type: 'brainstem',
						energy: 0,
						phase: Math.random() * Math.PI * 2,
					});
				}

				// 4. NEURAL TRACTS (Internal synaptic nodes)
				const tractCount = 160;
				for (let i = 0; i < tractCount; i++) {
					const u = (Math.random() - 0.5) * 1.1;
					const v = (Math.random() - 0.5) * 0.7;
					const w = (Math.random() - 0.5) * 1.2;
					if ((u * u) / 0.45 + (v * v) / 0.35 + (w * w) / 0.7 < 0.65) {
						points.push({
							x: u,
							y: v + 0.1,
							z: w,
							nx: 0,
							ny: 1,
							nz: 0,
							type: 'tract',
							energy: 0,
							phase: Math.random() * Math.PI * 2,
						});
					}
				}

				return points;
			}

			const canvas = document.getElementById('brain-canvas') as HTMLCanvasElement | null;
			const container = document.querySelector('[data-brain]') as HTMLElement | null;
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (canvas && container) {
				const ctx = canvas.getContext('2d');
				const points = createBrainModel();
				const pulses: SynapticPulse[] = [];

				let width = 0;
				let height = 0;
				let dpr = 1;
				let cols = 64;
				let rows = 32;
				let charW = 10;
				let charH = 18;
				let fontSize = 12;

				let baseRotY = 0.65;
				let currentRotY = 0.65;
				let targetRotY = 0.65;
				let currentRotX = 0.2;
				let targetRotX = 0.2;

				let isDragging = false;
				let lastDragX = 0;
				let lastDragY = 0;
				let dragVelocityX = 0;
				let dragVelocityY = 0;

				let pointerX = 0.5;
				let pointerY = 0.5;
				let isHovering = false;
				let lastTime = performance.now();
				let lastPulseSpawn = 0;

				const palette = [' ', '.', ':', '-', '=', '+', '*', '#', '%', '@'];

				const resize = () => {
					const rect = container.getBoundingClientRect();
					dpr = Math.min(window.devicePixelRatio || 1, 2);
					width = rect.width;
					height = rect.height;

					canvas.width = Math.floor(width * dpr);
					canvas.height = Math.floor(height * dpr);

					if (ctx) {
						ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					}

					fontSize = width < 480 ? 10.5 : width < 768 ? 12 : 13;
					charH = Math.round(fontSize * 1.24);

					if (ctx) {
						ctx.font = `${fontSize}px 'DM Mono', Consolas, monospace`;
						charW = Math.max(6, ctx.measureText('M').width);
					} else {
						charW = fontSize * 0.62;
					}

					cols = Math.max(24, Math.floor(width / charW));
					rows = Math.max(16, Math.floor(height / charH));
				};

				const resizeObserver = new ResizeObserver(() => resize());
				resizeObserver.observe(container);
				resize();

				const spawnPulse = (originX = 0, originY = 0, originZ = 0) => {
					pulses.push({
						x: originX,
						y: originY,
						z: originZ,
						time: performance.now(),
						speed: 1.8,
						maxRadius: 1.4,
					});
					if (pulses.length > 5) pulses.shift();
				};

				// Pointer interactions
				const handlePointerMove = (event: PointerEvent) => {
					const rect = container.getBoundingClientRect();
					pointerX = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
					pointerY = Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height));
					isHovering = true;

					container.style.setProperty('--cursor-x', `${pointerX * 100}%`);
					container.style.setProperty('--cursor-y', `${pointerY * 100}%`);

					if (isDragging) {
						const dx = event.clientX - lastDragX;
						const dy = event.clientY - lastDragY;
						dragVelocityX = dx * 0.007;
						dragVelocityY = dy * 0.007;
						targetRotY += dragVelocityX;
						targetRotX = Math.max(-0.6, Math.min(0.8, targetRotX - dragVelocityY));
						lastDragX = event.clientX;
						lastDragY = event.clientY;
					} else {
						targetRotY = baseRotY + (pointerX - 0.5) * 0.85;
						targetRotX = 0.2 + (pointerY - 0.5) * 0.55;

						if (Math.random() < 0.06) {
							spawnPulse((pointerX - 0.5) * 1.5, -(pointerY - 0.5) * 1.2, 0.4);
						}
					}
				};

				container.addEventListener('pointerdown', (event) => {
					isDragging = true;
					lastDragX = event.clientX;
					lastDragY = event.clientY;
					dragVelocityX = 0;
					dragVelocityY = 0;
					spawnPulse((pointerX - 0.5) * 1.6, -(pointerY - 0.5) * 1.2, 0.5);
					container.setPointerCapture(event.pointerId);
				});

				container.addEventListener('pointermove', handlePointerMove);

				const handlePointerEnd = (event: PointerEvent) => {
					if (isDragging) {
						isDragging = false;
						try {
							container.releasePointerCapture(event.pointerId);
						} catch {}
					}
				};

				container.addEventListener('pointerup', handlePointerEnd);
				container.addEventListener('pointercancel', handlePointerEnd);

				container.addEventListener('pointerleave', () => {
					isHovering = false;
					if (!isDragging) {
						targetRotX = 0.2;
					}
				});

				// Main Animation Loop
				const render = (now: number) => {
					const dt = Math.min((now - lastTime) / 1000, 0.1);
					lastTime = now;

					if (!isDragging && !prefersReducedMotion) {
						baseRotY += dt * 0.2;
						if (!isHovering) {
							targetRotY = baseRotY;
							targetRotX = 0.18 + Math.sin(now * 0.0012) * 0.06;
						}
					}

					// Apply drag inertia
					if (!isDragging && Math.abs(dragVelocityX) > 0.0001) {
						baseRotY += dragVelocityX;
						targetRotY += dragVelocityX;
						dragVelocityX *= 0.92;
					}
					if (!isDragging && Math.abs(dragVelocityY) > 0.0001) {
						targetRotX = Math.max(-0.6, Math.min(0.8, targetRotX - dragVelocityY));
						dragVelocityY *= 0.92;
					}

					// Smooth rotation easing
					currentRotY += (targetRotY - currentRotY) * 0.09;
					currentRotX += (targetRotX - currentRotX) * 0.09;

					// Spontaneous synaptic firing
					if (now - lastPulseSpawn > 2600) {
						lastPulseSpawn = now;
						const randPt = points[Math.floor(Math.random() * points.length)];
						spawnPulse(randPt.x, randPt.y, randPt.z);
					}

					if (ctx) {
						ctx.clearRect(0, 0, width, height);

						// 2D frame buffers
						const charBuffer: string[][] = Array.from({ length: rows }, () => Array(cols).fill(' '));
						const colorBuffer: string[][] = Array.from({ length: rows }, () => Array(cols).fill(''));
						const glowBuffer: boolean[][] = Array.from({ length: rows }, () => Array(cols).fill(false));
						const zBuffer: number[][] = Array.from({ length: rows }, () => Array(cols).fill(-999));

						const cosY = Math.cos(currentRotY);
						const sinY = Math.sin(currentRotY);
						const cosX = Math.cos(currentRotX);
						const sinX = Math.sin(currentRotX);

						// Light vector
						const nlx = 0.42,
							nly = 0.62,
							nlz = 0.66;

						// Project and shade points
						for (let i = 0; i < points.length; i++) {
							const pt = points[i];

							// 3D rotation
							const x1 = pt.x * cosY + pt.z * sinY;
							const y1 = pt.y;
							const z1 = -pt.x * sinY + pt.z * cosY;

							const x2 = x1;
							const y2 = y1 * cosX - z1 * sinX;
							const z2 = y1 * sinX + z1 * cosX;

							// Rotate normals
							const nx1 = pt.nx * cosY + pt.nz * sinY;
							const ny1 = pt.ny;
							const nz1 = -pt.nx * sinY + pt.nz * cosY;

							const nx2 = nx1;
							const ny2 = ny1 * cosX - nz1 * sinX;
							const nz2 = ny1 * sinX + nz1 * cosX;

							// Perspective projection
							const camDist = 3.2;
							const scale = Math.min(width * 0.72, height * 1.05) * 0.98;
							const factor = scale / (camDist + z2);

							const centerCol = width >= 860 ? Math.floor(cols * 0.58) : Math.floor(cols * 0.5);
							const centerRow = Math.floor(rows * 0.48);

							const col = Math.floor(centerCol + (x2 * factor * 1.95) / charW);
							const row = Math.floor(centerRow - (y2 * factor) / charH);

							if (col >= 0 && col < cols && row >= 0 && row < rows) {
								if (z2 > zBuffer[row][col]) {
									zBuffer[row][col] = z2;

									// Pulse energy computation
									let pulseEnergy = 0;
									for (let p = 0; p < pulses.length; p++) {
										const pulse = pulses[p];
										const age = (now - pulse.time) / 1000;
										const currentRadius = age * pulse.speed;
										if (currentRadius < pulse.maxRadius) {
											const dx = pt.x - pulse.x;
											const dy = pt.y - pulse.y;
											const dz = pt.z - pulse.z;
											const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
											const waveDist = Math.abs(dist - currentRadius);
											if (waveDist < 0.22) {
												const intensity = (1 - waveDist / 0.22) * Math.max(0, 1 - currentRadius / pulse.maxRadius);
												pulseEnergy = Math.max(pulseEnergy, intensity);
											}
										}
									}

									const dot = Math.max(0, nx2 * nlx + ny2 * nly + nz2 * nlz);
									const depth = (z2 + 1.5) / 3.0;
									const breathe = Math.sin(now * 0.002 + pt.phase) * 0.08;
									const totalIntensity = Math.min(1, Math.max(0, dot * 0.5 + depth * 0.42 + breathe + pulseEnergy * 0.7));

									let charIndex = Math.floor(totalIntensity * (palette.length - 1));
									let char = palette[charIndex];

									if (pulseEnergy > 0.45) {
										char = pulseEnergy > 0.75 ? '@' : '*';
										colorBuffer[row][col] = '#ffffff';
										glowBuffer[row][col] = true;
									} else if (pt.type === 'cerebellum') {
										char = totalIntensity > 0.6 ? '=' : totalIntensity > 0.35 ? '~' : '-';
										colorBuffer[row][col] = `rgba(131, 246, 212, ${0.28 + depth * 0.3})`;
									} else if (pt.type === 'brainstem') {
										char = totalIntensity > 0.5 ? '|' : ':';
										colorBuffer[row][col] = `rgba(131, 246, 212, ${0.25 + depth * 0.28})`;
									} else {
										if (totalIntensity > 0.82) {
											colorBuffer[row][col] = 'rgba(202, 255, 239, 0.88)';
											glowBuffer[row][col] = true;
										} else if (totalIntensity > 0.5) {
											colorBuffer[row][col] = `rgba(131, 246, 212, ${0.38 + depth * 0.36})`;
										} else {
											colorBuffer[row][col] = `rgba(60, 110, 92, ${0.14 + depth * 0.22})`;
										}
									}

									charBuffer[row][col] = char;
								}
							}
						}

						// Draw to canvas
						ctx.font = `${fontSize}px 'DM Mono', Consolas, monospace`;
						ctx.textBaseline = 'top';

						for (let r = 0; r < rows; r++) {
							const y = r * charH;
							for (let c = 0; c < cols; c++) {
								const char = charBuffer[r][c];
								if (char !== ' ') {
									ctx.fillStyle = colorBuffer[r][c] || '#83f6d4';
									if (glowBuffer[r][c]) {
										ctx.shadowColor = '#83f6d4';
										ctx.shadowBlur = 8;
									} else {
										ctx.shadowBlur = 0;
									}
									ctx.fillText(char, c * charW, y);
								}
							}
						}
					}

					window.requestAnimationFrame(render);
				};

				window.requestAnimationFrame(render);
			}
		</script>
	</body>
</html>
