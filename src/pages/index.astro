---
import '../styles/global.css';

const researchAreas = [
	{
		number: '01',
		title: 'Inverse problems & generative learning',
		description:
			'We design principled algorithms that recover structure—and uncertainty—from incomplete measurements.',
		tags: ['Inverse problems', 'Diffusion & flow', 'Posterior sampling'],
	},
	{
		number: '02',
		title: 'Biomedical imaging & quantification',
		description:
			'We turn PET, SPECT, CT, and MRI into reliable quantitative evidence for research and clinical decisions.',
		tags: ['PET / SPECT', 'Quantitative AI', 'Clinical translation'],
	},
	{
		number: '03',
		title: 'Embodied perception & robotics',
		description:
			'We extend measurement-aware intelligence to systems that must perceive, reason, and act in the physical world.',
		tags: ['Robot learning', 'VLA', 'Perception–action'],
	},
];

const selectedWork = [
	{
		year: '2025',
		venue: 'Journal of Nuclear Medicine',
		title: 'AI-powered quantification of flortaucipir PET for detecting tau pathology',
		note: 'Co-first author',
	},
	{
		year: '2024',
		venue: 'British Journal of Radiology',
		title: 'Sixty-four-fold data reduction of chest radiographs using super-resolution',
		note: 'Co-first author',
	},
	{
		year: '2023',
		venue: 'Journal of Nuclear Medicine',
		title: 'Fast and accurate amyloid brain PET quantification without MRI',
		note: 'First author',
	},
	{
		year: '2021',
		venue: 'NeuroImage',
		title: 'Translating amyloid PET of different radiotracers with a deep generative model',
		note: 'First author',
	},
];

function generateLateralBrainMap(width = 92, height = 40) {
	const grid = Array.from({ length: height }, () => Array(width).fill(' '));
	const intensityGrid = Array.from({ length: height }, () => Array(width).fill(0));
	const typeGrid = Array.from({ length: height }, () => Array(width).fill(''));

	for (let r = 0; r < height; r++) {
		for (let c = 0; c < width; c++) {
			const u = (c / (width - 1) - 0.5) * 2.3;
			const v = (0.5 - r / (height - 1)) * 2.1;

			const uCortex = u - 0.02;
			const vCortex = v - 0.12;
			const frontalTaper = u > 0 ? 1.0 - 0.08 * u : 1.0 + 0.12 * u;
			const topDome = v > 0 ? 1.0 - 0.05 * v : 1.0;

			const rOuter =
				Math.pow(Math.abs(uCortex / (0.92 * frontalTaper)), 2.3) +
				Math.pow(Math.abs(vCortex / (0.8 * topDome)), 2.3);

			const cortexMask = rOuter <= 1.0;
			const sylvianFissure =
				v > -0.18 &&
				v < 0.04 &&
				u > -0.05 &&
				u < 0.68 &&
				Math.sin(((v + 0.18) / 0.22) * Math.PI) > 0.65 &&
				u > 0.05 + (0.04 - v) * 2.0;

			const cerebellarCutout = u < 0.08 && v < -0.15 && (u < -0.12 || v < -0.28);
			const inCortex = cortexMask && !sylvianFissure && !cerebellarCutout;

			const uCereb = (u + 0.42) / 0.36;
			const vCereb = (v + 0.45) / 0.25;
			const rCereb = uCereb * uCereb + vCereb * vCereb;
			const inCerebellum = rCereb <= 1.0 && u < 0.02 && v < -0.16 && v > -0.74;

			const inBrainstem =
				u >= -0.15 &&
				u <= 0.14 &&
				v <= -0.25 &&
				v >= -0.92 &&
				u <= 0.1 + 0.08 * Math.exp(-Math.pow((v + 0.52) / 0.14, 2));

			if (inCortex) {
				const w1 = Math.sin(7.5 * v + 4.5 * u) * 0.25;
				const w2 = Math.cos(7.0 * u + 5.0 * v) * 0.25;
				const uw = u + w1;
				const vw = v + w2;

				const centralDist = Math.abs(u - 0.55 * v - 0.12);
				const isCentralSulcus = centralDist < 0.06 && v > -0.15;

				const g1 = Math.sin(15.0 * uw + 11.0 * vw);
				const g2 = Math.cos(14.0 * vw - 10.0 * uw + Math.sin(12.0 * uw) * 1.5);
				const g3 = Math.sin(19.0 * uw - 15.0 * vw) * 0.4;
				const gyriWave = g1 * 0.55 + g2 * 0.45 + g3;

				const edge = rOuter > 0.88;
				const intensity = isCentralSulcus
					? 0.15
					: edge
						? 0.85
						: Math.max(0.1, Math.min(1.0, 0.5 + gyriWave * 0.45));

				intensityGrid[r][c] = intensity;
				typeGrid[r][c] = isCentralSulcus ? 'sulcus' : edge ? 'edge' : 'gyrus';
			} else if (inCerebellum) {
				const folia = (Math.sin(v * 45.0) + 1.0) * 0.5;
				const edge = rCereb > 0.85;
				intensityGrid[r][c] = edge ? 0.75 : 0.35 + folia * 0.45;
				typeGrid[r][c] = 'cerebellum';
			} else if (inBrainstem) {
				const edge = u <= -0.13 || u >= 0.08;
				intensityGrid[r][c] = edge ? 0.7 : 0.45;
				typeGrid[r][c] = 'brainstem';
			}
		}
	}

	const palette = [' ', '.', ':', '-', '=', '+', '*', '#', '%', '@'];
	const cerebChars = ['-', '~', '=', '≡', '='];

	for (let r = 0; r < height; r++) {
		for (let c = 0; c < width; c++) {
			const type = typeGrid[r][c];
			const val = intensityGrid[r][c];
			if (!type) continue;

			if (type === 'cerebellum') {
				const idx = Math.min(cerebChars.length - 1, Math.floor(val * cerebChars.length));
				grid[r][c] = cerebChars[idx];
			} else if (type === 'brainstem') {
				grid[r][c] = val > 0.6 ? '|' : ':';
			} else if (type === 'sulcus') {
				grid[r][c] = '.';
			} else {
				const idx = Math.min(palette.length - 1, Math.floor(val * (palette.length - 1)) + 1);
				grid[r][c] = palette[idx];
			}
		}
	}

	return grid.map((row) => row.join('')).join('\n');
}

const fallbackAscii = generateLateralBrainMap(92, 40);

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ResearchOrganization',
	name: 'Biomedical Imaging and Frontier Intelligence Laboratory',
	alternateName: 'BIFIL',
	url: 'https://bifil.github.io',
	description:
		'Mathematically grounded AI for biomedical imaging, generative inverse problems, trustworthy quantification, and embodied perception.',
	parentOrganization: {
		'@type': 'CollegeOrUniversity',
		name: 'Daegu Gyeongbuk Institute of Science and Technology',
		alternateName: 'DGIST',
	},
	founder: {
		'@type': 'Person',
		name: 'Seung Kwan Kang',
		jobTitle: 'Assistant Professor',
		email: 'skang@dgist.ac.kr',
	},
};
---

