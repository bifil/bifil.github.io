			</div>
		</footer>

		<script>
			interface LateralNode {
				u: number;
				v: number;
				char: string;
				type: 'gyrus' | 'sulcus' | 'edge' | 'cerebellum' | 'brainstem';
				intensity: number;
				phase: number;
				baseX: number;
				baseY: number;
				currX: number;
				currY: number;
				targetX: number;
				targetY: number;
				vx: number;
				vy: number;
				energy: number;
			}

			interface SynapticPulse {
				x: number;
				y: number;
				time: number;
				speed: number;
				maxRadius: number;
			}

			function createLateralBrainNodes(): LateralNode[] {
				const nodes: LateralNode[] = [];
				const width = 94;
				const height = 42;

				const palette = [' ', '.', ':', '-', '=', '+', '*', '#', '%', '@'];
				const cerebChars = ['-', '~', '=', '≡', '='];

				for (let r = 0; r < height; r++) {
					for (let c = 0; c < width; c++) {
						const u = (c / (width - 1) - 0.5) * 2.3;
						const v = (0.5 - r / (height - 1)) * 2.1;

						const uCortex = u - 0.02;
						const vCortex = v - 0.12;
						const frontalTaper = u > 0 ? 1.0 - 0.08 * u : 1.0 + 0.12 * u;
						const topDome = v > 0 ? 1.0 - 0.05 * v : 1.0;

						const rOuter =
							Math.pow(Math.abs(uCortex / (0.92 * frontalTaper)), 2.3) +
							Math.pow(Math.abs(vCortex / (0.8 * topDome)), 2.3);

						const cortexMask = rOuter <= 1.0;
						const sylvianFissure =
							v > -0.18 &&
							v < 0.04 &&
							u > -0.05 &&
							u < 0.68 &&
							Math.sin(((v + 0.18) / 0.22) * Math.PI) > 0.65 &&
							u > 0.05 + (0.04 - v) * 2.0;

						const cerebellarCutout = u < 0.08 && v < -0.15 && (u < -0.12 || v < -0.28);
						const inCortex = cortexMask && !sylvianFissure && !cerebellarCutout;

						const uCereb = (u + 0.42) / 0.36;
						const vCereb = (v + 0.45) / 0.25;
						const rCereb = uCereb * uCereb + vCereb * vCereb;
						const inCerebellum = rCereb <= 1.0 && u < 0.02 && v < -0.16 && v > -0.74;

						const inBrainstem =
							u >= -0.15 &&
							u <= 0.14 &&
							v <= -0.25 &&
							v >= -0.92 &&
							u <= 0.1 + 0.08 * Math.exp(-Math.pow((v + 0.52) / 0.14, 2));

						let type: 'gyrus' | 'sulcus' | 'edge' | 'cerebellum' | 'brainstem' | null = null;
						let intensity = 0;
						let char = ' ';

						if (inCortex) {
							const w1 = Math.sin(7.5 * v + 4.5 * u) * 0.25;
							const w2 = Math.cos(7.0 * u + 5.0 * v) * 0.25;
							const uw = u + w1;
							const vw = v + w2;

							const centralDist = Math.abs(u - 0.55 * v - 0.12);
							const isCentralSulcus = centralDist < 0.06 && v > -0.15;

							const g1 = Math.sin(15.0 * uw + 11.0 * vw);
							const g2 = Math.cos(14.0 * vw - 10.0 * uw + Math.sin(12.0 * uw) * 1.5);
							const g3 = Math.sin(19.0 * uw - 15.0 * vw) * 0.4;
							const gyriWave = g1 * 0.55 + g2 * 0.45 + g3;

							const edge = rOuter > 0.88;
							intensity = isCentralSulcus
								? 0.15
								: edge
									? 0.85
									: Math.max(0.1, Math.min(1.0, 0.5 + gyriWave * 0.45));

							type = isCentralSulcus ? 'sulcus' : edge ? 'edge' : 'gyrus';
							if (type === 'sulcus') {
								char = '.';
							} else {
								const idx = Math.min(palette.length - 1, Math.floor(intensity * (palette.length - 1)) + 1);
								char = palette[idx];
							}
						} else if (inCerebellum) {
							const folia = (Math.sin(v * 45.0) + 1.0) * 0.5;
							const edge = rCereb > 0.85;
							intensity = edge ? 0.75 : 0.35 + folia * 0.45;
							type = 'cerebellum';
							const idx = Math.min(cerebChars.length - 1, Math.floor(intensity * cerebChars.length));
							char = cerebChars[idx];
						} else if (inBrainstem) {
							const edge = u <= -0.13 || u >= 0.08;
							intensity = edge ? 0.7 : 0.45;
							type = 'brainstem';
							char = intensity > 0.6 ? '|' : ':';
						}

						if (type && char !== ' ') {
							nodes.push({
								u,
								v,
								char,
								type,
								intensity,
								phase: Math.random() * Math.PI * 2,
								baseX: 0,
								baseY: 0,
								currX: 0,
								currY: 0,
								targetX: 0,
								targetY: 0,
								vx: 0,
								vy: 0,
								energy: 0,
							});
						}
					}
				}

				return nodes;
			}

			const canvas = document.getElementById('brain-canvas') as HTMLCanvasElement | null;
			const container = document.querySelector('[data-brain]') as HTMLElement | null;
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (canvas && container) {
				const ctx = canvas.getContext('2d');
				const nodes = createLateralBrainNodes();
				const pulses: SynapticPulse[] = [];

				let width = 0;
				let height = 0;
				let dpr = 1;
				let fontSize = 12;
				let lastTime = performance.now();
				let lastPulseSpawn = 0;

				let isHovering = false;
				let pointerX = -9999;
				let pointerY = -9999;

				const resize = () => {
					const rect = container.getBoundingClientRect();
					dpr = Math.min(window.devicePixelRatio || 1, 2);
					width = rect.width;
					height = rect.height;

					canvas.width = Math.floor(width * dpr);
					canvas.height = Math.floor(height * dpr);

					if (ctx) {
						ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					}

					fontSize = width < 480 ? 9.5 : width < 768 ? 11 : 12.5;

					const originX = width >= 860 ? width * 0.58 : width * 0.5;
					const originY = height * 0.48;
					const brainScale = Math.min(width * 0.4, height * 0.46);

					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						node.baseX = originX + node.u * brainScale * 1.05;
						node.baseY = originY - node.v * brainScale;
						if (node.currX === 0 && node.currY === 0) {
							node.currX = node.baseX;
							node.currY = node.baseY;
							node.targetX = node.baseX;
							node.targetY = node.baseY;
						}
					}
				};

				const resizeObserver = new ResizeObserver(() => resize());
				resizeObserver.observe(container);
				resize();

				const spawnPulse = (originX: number, originY: number) => {
					pulses.push({
						x: originX,
						y: originY,
						time: performance.now(),
						speed: 260, // px per second
						maxRadius: Math.max(width, height) * 0.6,
					});
					if (pulses.length > 5) pulses.shift();
				};

				// Mouse pointer interactions: morph & transition
				const handlePointerMove = (event: PointerEvent) => {
					const rect = container.getBoundingClientRect();
					pointerX = event.clientX - rect.left;
					pointerY = event.clientY - rect.top;
					isHovering = true;

					const relX = Math.min(1, Math.max(0, pointerX / rect.width));
					const relY = Math.min(1, Math.max(0, pointerY / rect.height));
					container.style.setProperty('--cursor-x', `${relX * 100}%`);
					container.style.setProperty('--cursor-y', `${relY * 100}%`);

					// Apply fluid morphing to nearby nodes
					const influenceRadius = Math.min(240, width * 0.28);
					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						const dx = pointerX - node.baseX;
						const dy = pointerY - node.baseY;
						const dist = Math.hypot(dx, dy);

						if (dist < influenceRadius) {
							const t = 1 - dist / influenceRadius;
							const force = t * t * 24;
							const swirl = Math.sin(t * Math.PI * 3.0 + node.phase) * (t * 6);
							const swirlY = Math.cos(t * Math.PI * 3.0 + node.phase) * (t * 5);

							node.targetX = node.baseX - (dx / (dist + 1)) * force + swirl;
							node.targetY = node.baseY - (dy / (dist + 1)) * force * 0.65 + swirlY;
							node.energy = Math.max(node.energy, t * 1.25);
						}
					}

					if (Math.random() < 0.05) {
						spawnPulse(pointerX, pointerY);
					}
				};

				container.addEventListener('pointermove', handlePointerMove);

				container.addEventListener('pointerdown', (event) => {
					const rect = container.getBoundingClientRect();
					const clickX = event.clientX - rect.left;
					const clickY = event.clientY - rect.top;
					spawnPulse(clickX, clickY);

					// Shockwave morph
					for (let i = 0; i < nodes.length; i++) {
						const node = nodes[i];
						const dx = clickX - node.baseX;
						const dy = clickY - node.baseY;
						const dist = Math.hypot(dx, dy);
						if (dist < 260) {
							const t = 1 - dist / 260;
							node.targetX = node.baseX - (dx / (dist + 1)) * (t * 32);
							node.targetY = node.baseY - (dy / (dist + 1)) * (t * 22);
							node.energy = 1.0;
						}
					}
				});

				container.addEventListener('pointerleave', () => {
					isHovering = false;
					pointerX = -9999;
					pointerY = -9999;
				});

				// Main Animation Loop
				const render = (now: number) => {
					lastTime = now;

					// Spontaneous pulse
					if (now - lastPulseSpawn > 3200 && !prefersReducedMotion) {
						lastPulseSpawn = now;
						const randNode = nodes[Math.floor(Math.random() * nodes.length)];
						if (randNode) spawnPulse(randNode.baseX, randNode.baseY);
					}

					if (ctx) {
						ctx.clearRect(0, 0, width, height);
						ctx.font = `${fontSize}px 'DM Mono', Consolas, monospace`;
						ctx.textBaseline = 'middle';
						ctx.textAlign = 'center';

						// Update spring return physics & pulse excitations
						for (let i = 0; i < nodes.length; i++) {
							const node = nodes[i];

							// If not actively displaced by pointer, relax target back to base rest position
							if (!isHovering || Math.hypot(pointerX - node.baseX, pointerY - node.baseY) >= 240) {
								node.targetX += (node.baseX - node.targetX) * 0.12;
								node.targetY += (node.baseY - node.targetY) * 0.12;
							}

							// Spring physics interpolation
							node.vx = (node.vx + (node.targetX - node.currX) * 0.14) * 0.78;
							node.vy = (node.vy + (node.targetY - node.currY) * 0.14) * 0.78;
							node.currX += node.vx;
							node.currY += node.vy;

							// Pulse wave excitation
							for (let p = 0; p < pulses.length; p++) {
								const pulse = pulses[p];
								const age = (now - pulse.time) / 1000;
								const currentRadius = age * pulse.speed;
								if (currentRadius < pulse.maxRadius) {
									const dist = Math.hypot(node.baseX - pulse.x, node.baseY - pulse.y);
									const waveDist = Math.abs(dist - currentRadius);
									if (waveDist < 26) {
										const pulseStrength = (1 - waveDist / 26) * Math.max(0, 1 - currentRadius / pulse.maxRadius);
										node.energy = Math.max(node.energy, pulseStrength);
									}
								}
							}

							// Energy decay
							node.energy *= 0.94;

							// Subtle breathing wave
							const breathe = Math.sin(now * 0.002 + node.phase) * 0.6;
							const drawY = node.currY + breathe;
							const drawX = node.currX;

							// Color & Glow rendering
							if (node.energy > 0.45) {
								ctx.fillStyle = '#ffffff';
								ctx.shadowColor = '#83f6d4';
								ctx.shadowBlur = 10;
							} else if (node.type === 'edge' || (node.type === 'gyrus' && node.intensity > 0.7)) {
								ctx.fillStyle = 'rgba(202, 255, 239, 0.88)';
								ctx.shadowColor = '#83f6d4';
								ctx.shadowBlur = 4;
							} else if (node.type === 'cerebellum') {
								ctx.fillStyle = `rgba(131, 246, 212, ${0.35 + node.energy * 0.4})`;
								ctx.shadowBlur = 0;
							} else if (node.type === 'brainstem') {
								ctx.fillStyle = `rgba(131, 246, 212, ${0.32 + node.energy * 0.4})`;
								ctx.shadowBlur = 0;
							} else if (node.type === 'sulcus') {
								ctx.fillStyle = 'rgba(60, 110, 92, 0.22)';
								ctx.shadowBlur = 0;
							} else {
								ctx.fillStyle = `rgba(131, 246, 212, ${0.45 + node.intensity * 0.35 + node.energy * 0.4})`;
								ctx.shadowBlur = 0;
							}

							ctx.fillText(node.char, drawX, drawY);
						}
					}

					window.requestAnimationFrame(render);
				};

				window.requestAnimationFrame(render);
			}
		</script>
	</body>
</html>
